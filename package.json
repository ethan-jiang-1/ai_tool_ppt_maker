{
  "name": "pptmaker-harness",
  "version": "0.25.0",
  "description": "Agent-driven PPT generation pipeline — production scripts (Node.js ESM)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node tests/contracts/run_development_verification.mjs",
    "test:sweep": "vitest run",
    "test:focused": "node tests/contracts/run_selected_verification.mjs focused",
    "test:mock-e2e": "node tests/contracts/run_selected_verification.mjs journey",
    "test:real-e2e": "node tests/contracts/run_selected_verification.mjs real-e2e",
    "setup:chromium": "playwright install chromium",
    "setup:chromium:with-deps": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.68",
    "commander": "^13.1.0",
    "fast-png": "8.0.0",
    "jpeg-js": "0.4.4",
    "jszip": "^3.10.1",
    "playwright": "1.61.1",
    "pptxgenjs": "^4.0.1",
    "saxes": "6.0.0",
    "sharp": "^0.35.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
