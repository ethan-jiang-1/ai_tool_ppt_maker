{
  "name": "ppkmaker-framework",
  "version": "0.15.0",
  "description": "Agent-driven PPT generation pipeline — production scripts (Node.js ESM)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bench:html-catalog": "node tests/benchmarks/html_asset_catalog_worst_case.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.mjs",
    "setup:chromium": "playwright install chromium",
    "setup:chromium:with-deps": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.68",
    "commander": "^13.1.0",
    "echarts": "6.1.0",
    "fast-png": "8.0.0",
    "jpeg-js": "0.4.4",
    "jszip": "^3.10.1",
    "playwright": "1.61.1",
    "pptxgenjs": "^4.0.1",
    "saxes": "6.0.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
