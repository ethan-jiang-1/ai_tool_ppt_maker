        "weight": 600,
        "size": 16,
        "line_height": 1.2,
        "color": "palette.muted_text"
      },
      "title": {
        "families": [
          "Source Sans 3",
          "Noto Sans SC"
        ],
        "weight": 700,
        "size": 30,
        "line_height": 1.1,
        "color": "palette.text"
      },
      "subtitle": {
        "families": [
          "Source Sans 3",
          "Noto Sans SC"
        ],
        "weight": 400,
        "size": 18,
        "line_height": 1.2,
        "color": "palette.muted_text"
      },
      "body": {
        "families": [
          "Source Sans 3",
          "Noto Sans SC"
