{
  "name": "Corporate Safe",
  "description": "White background with corporate blue and slate gray. Professional, trustworthy, timeless. Like McKinsey or Goldman Sachs presentations.",
  "background": "#ffffff",
  "canvas": {"width_px": 1672, "height_px": 941},
  "body_layout": {
    "content_top_gap_px": 30,
    "content_bottom_px": 780,
    "callout_top_px": 805,
    "callout_bottom_px": 900,
    "no_callout_bottom_px": 890
  },
  "colors": {
    "panel_card": {"hex": "#f8fafc", "role": "Card and panel backgrounds"},
    "primary_text": {"hex": "#0f172a", "role": "Body text, titles"},
    "secondary_text": {"hex": "#475569", "role": "Secondary text, labels"},
    "primary_brand": {"hex": "#1e40af", "role": "Primary brand, title emphasis, icons"},
    "positive_accent": {"hex": "#059669", "role": "Growth data, positive outcomes"},
    "warning": {"hex": "#dc2626", "role": "Risk/downside signals only — use sparingly"},
    "divider": {"hex": "#e2e8f0", "role": "Dividers, table borders"},
    "light_bg": {"hex": "#f1f5f9", "role": "Alternating row backgrounds, de-emphasized blocks"},
    "kicker": {"hex": "#475569", "role": "Slide kicker (Header-Lock overlay)"},
    "subtitle": {"hex": "#64748b", "role": "Slide subtitle (Header-Lock overlay)"}
  },
  "header_lock": {
    "body_header_safe_zone": 260,
    "opener_safe_zone": 390,
    "position": {
      "left_px": 46,
      "right_margin_px": 58,
      "kicker_y_px": 24,
      "title_y_px": 58,
      "subtitle_gap_px": 8,
      "title_line_height_px": 52,
      "subtitle_line_height_px": 31
    },
    "fonts": {
      "kicker": {"family": "Source Sans Pro", "weight": "Semibold", "size_px": 22, "color": "#475569"},
      "title": {"family": "Source Sans Pro", "weight": "Bold", "size_px": 46, "color": "#0f172a"},
      "subtitle": {"family": "Source Sans Pro", "weight": "Regular", "size_px": 27, "color": "#64748b"}
    }
  },
  "forbidden": ["neon colors", "dark backgrounds", "decorative elements", "stock photos", "logos (unless provided)", "watermarks", "page numbers"],
  "best_for": ["finance", "banking", "insurance", "government", "legal", "compliance", "multinational corporations", "formal settings"],
  "avoid_for": ["creative brands", "consumer tech pitches", "emotional stories", "young audiences"]
}
