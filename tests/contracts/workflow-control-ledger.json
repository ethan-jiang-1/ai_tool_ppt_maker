        "ppt_flow status"
      ],
      "invalidation": "any inspection checkpoint change",
      "reconstructibility": "yes",
      "decision": "retire-reader",
      "replacement_tests": [
        "tests/shared/state/test_state_yaml.mjs",
        "tests/contracts/test_process_workflow_inspection_cli.mjs"
      ]
    },
    {
